{
  "name": "impostor-catequesis",
  "version": "1.0.0-dev0.1",
  "description": "Juego social catequético inspirado en Impostor",
  "author": "Catequesis App",
  "private": true,

  "main": "electron/main.js",

  "scripts": {
    "ng": "ng",

    "────────── DESARROLLO WEB ──────────": "─────",
    "start": "ng serve",

    "────────── ELECTRON (ESCRITORIO) ──────────": "─────",
    "electron:dev": "concurrently \"ng serve\" \"wait-on http://localhost:4200 && npx electron electron/main.js --dev\"",
    "electron:prod": "npm run build:angular && npx electron electron/main.js",

    "────────── BUILD WINDOWS ──────────": "─────",
    "build:angular": "ng build --configuration production --base-href ./",
    "build:win": "npm run clean:build && npm run build:angular && electron-builder --win --x64 --publish=never",
    "build:win:dir": "npm run build:angular && electron-builder --win --x64 --dir --publish=never",

    "────────── BUILD ANDROID ──────────": "─────",
    "android": "npx ionic build && npx cap sync android && npx cap open android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",

    "────────── UTILIDADES ──────────": "─────",
    "icons:generate": "node scripts/generate-icons.js",
    "clean:build": "npx rimraf dist-electron www",
    "clean:cache:win": "node -e \"const{execSync}=require('child_process');try{execSync('rmdir /s /q \"%LOCALAPPDATA%\\\\electron-builder\\\\Cache\\\\winCodeSign\"',{shell:'cmd.exe'});console.log('Cache limpiado')}catch(e){console.log('Cache no encontrado (está bien)')}\"",
    "clean:all": "npm run clean:build && npm run clean:cache:win",

    "postinstall": "electron-builder install-app-deps"
  },

  "build": {
    "appId": "com.catequesis.impostor",
    "productName": "Impostor de Catequesis",

    "directories": {
      "output": "dist-electron",
      "buildResources": "resources"
    },

    "files": [
      "www/**/*",
      "electron/**/*",
      "package.json"
    ],

    "extraResources": [
      {
        "from": "src/assets/icons/",
        "to": "assets/icons/"
      }
    ],

    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "src/assets/icons/favicon.ico",
      "publish": null,
      "forceCodeSigning": false
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Impostor Catequesis",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },

  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/common": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/router": "^17.0.0",
    "@capacitor/android": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "@capacitor/splash-screen": "^5.0.0",
    "@ionic/angular": "^7.0.0",
    "ionicons": "^7.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.14.0"
  },

  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "@capacitor/cli": "^5.0.0",
    "@ionic/angular-toolkit": "^11.0.0",
    "concurrently": "^8.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^2.1.8",
    "rimraf": "^5.0.0",
    "typescript": "~5.2.0",
    "wait-on": "^7.0.0"
  }
}