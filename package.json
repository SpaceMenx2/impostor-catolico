{
  "name": "impostor-catequesis",
  "version": "1.0.0",
  "description": "Juego social catequético inspirado en Impostor",
  "author": "Catequesis App",
  "private": true,
  "build": {
    "appId": "com.catequesis.impostor",
    "productName": "Impostor de Catequesis",
    "directories": {
      "output": "dist-electron",
      "buildResources": "resources"
    },
    "files": [
      "www/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/assets/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "src/assets/icon.png",
      "publish": null
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Game",
      "icon": "src/assets/icon.png",
      "publish": null
    }
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "android": "ionic build && npx cap sync android && npx cap open android",
    "electron": "ng build --base-href ./ && npx electron electron/main.js",
    "electron:dev": "concurrently \"ng serve\" \"wait-on http://localhost:4200 && npx electron electron/main.js --dev\""
  },
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/common": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/router": "^17.0.0",
    "@capacitor/android": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "@ionic/angular": "^7.0.0",
    "ionicons": "^7.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "@capacitor/cli": "^5.0.0",
    "@ionic/angular-toolkit": "^11.0.0",
    "concurrently": "^8.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1",
    "typescript": "~5.2.0",
    "wait-on": "^7.0.0"
  }
}
